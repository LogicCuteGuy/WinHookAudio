[WHA.Device.NT.HW]
AddReg=WHA.HW.AddReg

[WHA.HW.AddReg]
; Sound device; system and administrators full, everyone may stream (as Microsoft's sample).
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[WHA.Device.NT.Services]
AddService=WinHookAudio,0x00000002,WHA.Service

[WHA.Service]
DisplayName=%WHA.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\WinHookAudio.sys

