HKR,,FriendlyName,,%WHA.OutputWave1.Desc%

[WHA.I.OutputTopology1]
AddReg=WHA.I.OutputTopology1.AddReg
[WHA.I.OutputTopology1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WHA.OutputTopology1.Desc%
