; WinHookAudio.inf - WinHookAudio Virtual Cable (PortCls WaveRT, root-enumerated Root\WinHookAudio).
; Each cable: a playback endpoint (Windows apps play into it -> DAW input) and a recording endpoint
; (DAW output -> Windows apps record it). driver/build.cmd stamps DriverVer and builds the catalog.

[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
CatalogFile=WinHookAudio.cat
DriverVer=01/01/2026,1.0.0.0
PnpLockdown=1

[SourceDisksNames]
1=%DiskName%

[SourceDisksFiles]
WinHookAudio.sys=1

[DestinationDirs]
DefaultDestDir=13

[Manufacturer]
%ProviderName%=WHA,NTamd64

[WHA.NTamd64]
%WHA.DeviceDesc%=WHA.Device,Root\WinHookAudio

[WHA.Device.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=WHA.CopyFiles
AddReg=WHA.AddReg

[WHA.CopyFiles]
WinHookAudio.sys

[WHA.AddReg]
HKR,,AssociatedFilters,,"wdmaud,redbook"
HKR,,Driver,,WinHookAudio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%WHA.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%WHA.DeviceDesc%
; Endpoint names (the topology filters' endpoint pin Name GUID, WHAMiniports.cpp)
HKLM,%MediaCategories%\%Output1.NameGuid%,Name,,%Output1.Name%
HKLM,%MediaCategories%\%Output1.NameGuid%,Display,1,00,00,00,00
HKLM,%MediaCategories%\%Input1.NameGuid%,Name,,%Input1.Name%
HKLM,%MediaCategories%\%Input1.NameGuid%,Display,1,00,00,00,00
