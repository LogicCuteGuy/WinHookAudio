; WinHookAudio Virtual Cable Driver
; WDK PortCls WaveRT 8x Stereo 64KB RingBuffer

[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=WinHookAudio.cat
DriverVer=09/16/2026,1.0.0.0
PnpLockdown=1

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%WinHookAudio.DeviceDesc%=WHA_Device, Root\WinHookAudio

[WHA_Device.NT]
CopyFiles=WHA_CopyFiles

[WHA_Device.NT.Services]
AddService=WinHookAudio,0x00000002,WHA_Service_Inst

[WHA_Service_Inst]
DisplayName=%WinHookAudio.SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WinHookAudio.sys

[WHA_CopyFiles]
WinHookAudio.sys

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
WinHookAudio.sys=1

[DestinationDirs]
WHA_CopyFiles=12

[Strings]
ManufacturerName="WinHookAudio"
WinHookAudio.DeviceDesc="WinHookAudio Virtual Cable (8x Stereo)"
WinHookAudio.SvcDesc="WinHookAudio Virtual Cable Driver"
DiskName="WinHookAudio Installation Disk"
